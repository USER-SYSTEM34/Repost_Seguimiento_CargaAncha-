use seguimiento_carga_ancha;
go

-- 1. empresa
create table empresa (
    id_empresa int primary key identity(1,1),
    razon_social nvarchar(150),
    ruc nvarchar(20) unique,
    direccion nvarchar(200),
    telefono nvarchar(20)
);

-- 2. vehiculo
create table vehiculo (
    id_vehiculo int primary key identity(1,1),
    id_empresa int foreign key references empresa(id_empresa),
    placa nvarchar(20) unique not null,
    marca nvarchar(50),
    modelo nvarchar(50),
    anio int,
    capacidad_toneladas decimal(10,2)
);

-- 3. conductor
create table conductor (
    id_conductor int primary key identity(1,1),
    nombre nvarchar(50),
    apellido nvarchar(50),
    licencia nvarchar(20) unique,
    telefono nvarchar(20)
);

-- 4. ruta
create table ruta (
    id_ruta int primary key identity(1,1),
    origen nvarchar(100),
    destino nvarchar(100),
    distancia_km decimal(10,2)
);

-- 5. monitoreo
create table monitoreo (
    id_monitoreo int primary key identity(1,1),
    id_vehiculo int foreign key references vehiculo(id_vehiculo),
    id_conductor int foreign key references conductor(id_conductor),
    id_ruta int foreign key references ruta(id_ruta),
    fecha_salida datetime,
    fecha_llegada datetime null,
    estado nvarchar(30)
);

-- 6. consumo_combustible
create table consumo_combustible (
    id_consumo int primary key identity(1,1),
    id_monitoreo int foreign key references monitoreo(id_monitoreo),
    cantidad_litros decimal(10,2),
    costo_total decimal(10,2),
    fecha_registro datetime default getdate()
);

-- 7. incidencia
create table incidencia (
    id_incidencia int primary key identity(1,1),
    id_monitoreo int foreign key references monitoreo(id_monitoreo),
    tipo nvarchar(50),
    descripcion nvarchar(200),
    fecha datetime
);

-- 8. mantenimiento
create table mantenimiento (
    id_mantenimiento int primary key identity(1,1),
    id_vehiculo int foreign key references vehiculo(id_vehiculo),
    descripcion nvarchar(200),
    fecha date,
    costo decimal(10,2)
);

-- 9. proveedor
create table proveedor (
    id_proveedor int primary key identity(1,1),
    nombre nvarchar(100),
    ruc nvarchar(20) unique,
    telefono nvarchar(20),
    direccion nvarchar(200)
);

-- 10. repuesto
create table repuesto (
    id_repuesto int primary key identity(1,1),
    id_proveedor int foreign key references proveedor(id_proveedor),
    nombre nvarchar(100),
    precio decimal(10,2),
    stock int
);
